<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ReMarkableRemember.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ReMarkableRemember.Views.LamyEraserView"
             x:DataType="vm:LamyEraserViewModel"
             MinWidth="480">

    <Design.DataContext>
        <vm:LamyEraserViewModel/>
    </Design.DataContext>

    <StackPanel>
        <TextBlock Text="{Binding LocalStrings.LamyEraserEraseBehavior}"/>
        <ComboBox SelectedIndex="{Binding Press}" Margin="0, 8, 0, 24" MinWidth="500">
            <ComboBoxItem Content="{Binding LocalStrings.LamyEraserEraseBehaviorToggle}"/>
            <ComboBoxItem Content="{Binding LocalStrings.LamyEraserEraseBehaviorPress}"/>
        </ComboBox>

        <TextBlock Text="{Binding LocalStrings.LamyEraserDoubleClickBehavior}"/>
        <ComboBox SelectedIndex="{Binding Undo}" Margin="0, 8, 0, 24" MinWidth="150">
            <ComboBoxItem Content="{Binding LocalStrings.LamyEraserDoubleClickBehaviorRedo}"/>
            <ComboBoxItem Content="{Binding LocalStrings.LamyEraserDoubleClickBehaviorUndo}"/>
        </ComboBox>

        <TextBlock Text="{Binding LocalStrings.LamyEraserLeftHanded}"/>
        <ComboBox SelectedIndex="{Binding LeftHanded}" Margin="0, 8, 0, 0" MinWidth="150">
            <ComboBoxItem Content="{Binding LocalStrings.LamyEraserLeftHandedNo}"/>
            <ComboBoxItem Content="{Binding LocalStrings.LamyEraserLeftHandedYes}"/>
        </ComboBox>
    </StackPanel>
</UserControl>
